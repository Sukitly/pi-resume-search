{
  "name": "pi-resume-search",
  "version": "0.1.0",
  "description": "A /resume picker for pi that shows which messages matched your search, backed by ripgrep.",
  "type": "module",
  "license": "MIT",
  "author": "Sukitly",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sukitly/pi-resume-search.git"
  },
  "homepage": "https://github.com/Sukitly/pi-resume-search#readme",
  "bugs": {
    "url": "https://github.com/Sukitly/pi-resume-search/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "resume",
    "session",
    "search"
  ],
  "files": [
    "extensions",
    "src",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./extensions/pi-resume-search.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "bun run typecheck && biome check --error-on-warnings .",
    "format": "biome check --write ."
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-tui": "0.85.1",
    "@types/node": "22.20.2",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
